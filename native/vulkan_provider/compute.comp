#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Counters { uint values[]; } counters;
void main() {
    // Atomic memory mutation: real device execution, not an empty dispatch.
    atomicAdd(counters.values[gl_GlobalInvocationID.x], 1u);
}
