#version 450
// A developer-editable replacement for the embedded native Vulkan compute shader.
// It maintains the same storage-buffer contract and increments every element.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Counters {
    uint values[];
} counters;
void main() {
    const uint increment = 1u;
    atomicAdd(counters.values[gl_GlobalInvocationID.x], increment);
}
